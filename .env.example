# Ably realtime API key (from https://ably.com dashboard → your app → API Keys).
# Needs the "Publish", "Subscribe", and "Presence" capabilities (the default root key has all).
ABLY_API_KEY=your-ably-key-here

# Vercel Blob read/write token.
# On Vercel this is set automatically when you connect a Blob store to the project.
# For local dev, run `vercel env pull .env.local` after linking the project, or paste it here.
BLOB_READ_WRITE_TOKEN=your-blob-token-here
